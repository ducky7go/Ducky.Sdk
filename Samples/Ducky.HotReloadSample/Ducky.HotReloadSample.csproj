<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\Local.props" Condition="Exists('../Local.props')" />

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>true</ImplicitUsings>
    <ModName>Ducky.HotReloadSample</ModName>
    <ModsDirectory>./Publish</ModsDirectory>
    <DeployMod>true</DeployMod>
    <IncludeHarmony>true</IncludeHarmony>
    <!-- Validation sample for development hot reload (docs/hot-reload.md). Hot reload is on for non-Release builds only. -->
    <DuckyHotReload Condition="'$(Configuration)' != 'Release'">true</DuckyHotReload>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Ducky.Sdk" Version="0.0.200101-dev">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Publish\" />
  </ItemGroup>
</Project>
