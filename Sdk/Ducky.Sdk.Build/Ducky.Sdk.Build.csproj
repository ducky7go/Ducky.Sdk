<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Build runner shipped inside the Ducky.Sdk package (tools/net10.0/Ducky.Sdk.Build.dll).
    It runs every mod build step out of process, so consumers need no dotnet-script or ilrepack.
    Framework-dependent: it needs the .NET 10 runtime; RollForward=Major lets a newer runtime run it.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RollForward>Major</RollForward>
    <AssemblyName>Ducky.Sdk.Build</AssemblyName>
    <RootNamespace>Ducky.Sdk.Build</RootNamespace>
    <Nullable>enable</Nullable>
    <UseAppHost>false</UseAppHost>
    <DefineConstants>$(DefineConstants);DUCKY_SDK_BUILD_SHARED</DefineConstants>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Ducky.Sdk.Lib.Tests" />
  </ItemGroup>

  <!-- Preview backgrounds (generated once by scripts/generate_preview_backgrounds.sh, see Assets/PreviewBackgrounds/README.md) -->
  <ItemGroup>
    <EmbeddedResource Include="Assets/PreviewBackgrounds/*.png" LogicalName="PreviewBackgrounds/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="ILRepack.Lib" />
  </ItemGroup>

  <!-- Shared localization sources (Sdk/Shared/Localization), compiled as internal code of this assembly. -->
  <ItemGroup>
    <Compile Include="..\Shared\Localization\LanguageCodes.cs" Link="Localizations\Shared\LanguageCodes.cs" />
    <Compile Include="..\Shared\Localization\CsvDocument.cs" Link="Localizations\Shared\CsvDocument.cs" />
    <Compile Include="..\Shared\Localization\KeyPatternSyntax.cs" Link="Localizations\Shared\KeyPatternSyntax.cs" />
  </ItemGroup>

</Project>
