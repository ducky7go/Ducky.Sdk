// Shim for development hot reload of __MOD_NAME__. Generated by the Ducky.Sdk build from HotReload/Shim.cs.template;
// do not edit the generated copy, change the template in the SDK instead.
//
// The game loads only this assembly (Assembly.LoadFrom(<mod>/__MOD_NAME__.dll), type __MOD_NAME__.ModBehaviour).
// The mod's own code is __MOD_NAME__.Core.<stamp>.dll, loaded from bytes into a child object. While the marker file
// hotreload.enabled exists in the mod folder, a newer Core is swapped in without restarting the game:
// destroy the old Core (its OnDisable cleans up), wait two frames, then load and start the new one.
// The shim itself is never reloaded: changing it needs a game restart.
#nullable disable

using System;
using System.Collections;
using System.Collections.Generic;
using System.IO;
using System.Linq;
using System.Reflection;
using Duckov.Utilities;
using UnityEngine;

namespace __MOD_NAME__
{
    public class ModBehaviour : Duckov.Modding.ModBehaviour
    {
        private const string ModName = "__MOD_NAME__";
        private const string CorePrefix = ModName + ".Core.";
        private const string MarkerFile = "hotreload.enabled";
        private const string ReportMethod = "HotReloadReport";
        private const float PollSeconds = 0.5f;
        private const float StableSeconds = 1.0f;
        private const int ReadAttempts = 5;
        private const float RetrySeconds = 0.5f;

        private string _dir = "";
        private int _loadCount;
        private bool _busy;
        private float _nextPoll;
        private GameObject _coreGo;
        private string _loadedName;          // assembly name of the running Core
        private DateTime _loadedWrite;
        private readonly Ducky.Sdk.HotReload.HotReloadSchedule.CoreWatch _watch =
            new Ducky.Sdk.HotReload.HotReloadSchedule.CoreWatch(StableSeconds);
        private readonly List<Assembly> _loadedCores = new List<Assembly>();
        private readonly List<Type> _loadedEntries = new List<Type>();
        private readonly HashSet<string> _loadedNames = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

        protected override void OnAfterSetup()
        {
            _dir = info.path;
            AppDomain.CurrentDomain.AssemblyResolve += OnResolve;
            Debug.Log($"[HotReload] shim up, mod={ModName} dir={_dir} watch={File.Exists(Path.Combine(_dir, MarkerFile))}");
            StartCoroutine(Reload("initial"));
        }

        private void OnDestroy()
        {
            AppDomain.CurrentDomain.AssemblyResolve -= OnResolve;
            if (_coreGo != null) Destroy(_coreGo);
            Debug.Log("[HotReload] shim destroyed");
        }

        private void Update()
        {
            if (_busy || _loadCount == 0 || Time.unscaledTime < _nextPoll) return;
            _nextPoll = Time.unscaledTime + PollSeconds;

            // Polling only while the marker exists; removing it stops reloads on the next check, without a restart.
            if (!File.Exists(Path.Combine(_dir, MarkerFile))) return;

            var newest = NewestCoreFile();
            if (newest == null) return;
            var name = Path.GetFileNameWithoutExtension(newest);
            var write = File.GetLastWriteTimeUtc(newest);

            switch (_watch.Observe(name, write, Time.unscaledTime, _loadedName, _loadedWrite, _loadedNames))
            {
                case Ducky.Sdk.HotReload.HotReloadSchedule.Step.Reject:
                    // The same assembly name again: the game keeps the first assembly with that name, so the old code would run.
                    // The build gives every Core a new stamp; a same-name file is refused and logged, never reported as a reload.
                    Debug.LogError($"[HotReload] {Path.GetFileName(newest)} has an assembly name that is already loaded in this session. " +
                                   "Same-name reloads are unsupported and the old code keeps running; restart the game to load it.");
                    break;
                case Ducky.Sdk.HotReload.HotReloadSchedule.Step.Reload:
                    StartCoroutine(Reload("new Core " + name));
                    break;
            }
        }

        private IEnumerator Reload(string reason)
        {
            _busy = true;
            Debug.Log($"[HotReload] reload #{_loadCount + 1} ({reason})");

            // 1. Read and load the new bytes before anything is destroyed: a locked or partial file keeps the running Core.
            var file = NewestCoreFile();
            byte[] bytes = null;
            Assembly asm = null;
            DateTime write = DateTime.MinValue;
            for (var attempt = 1; attempt <= ReadAttempts && asm == null; attempt++)
            {
                if (file == null) break;
                string failure = null;
                try
                {
                    write = File.GetLastWriteTimeUtc(file);
                    bytes = File.ReadAllBytes(file);
                    asm = Assembly.Load(bytes);
                }
                catch (Exception e) when (e is IOException || e is UnauthorizedAccessException || e is BadImageFormatException)
                {
                    failure = e.GetType().Name;
                }

                if (asm == null && failure != null)
                {
                    Debug.Log($"[HotReload] read/load attempt {attempt} for {Path.GetFileName(file)} failed ({failure}); retrying");
                    yield return new WaitForSecondsRealtime(RetrySeconds);
                    file = NewestCoreFile();
                }
            }

            if (asm == null)
            {
                Debug.LogError($"[HotReload] could not load a Core from {_dir}; the running Core keeps running.");
                _busy = false;
                yield break;
            }

            var entry = FindEntryType(asm);
            if (entry == null)
            {
                Debug.LogError($"[HotReload] {Path.GetFileName(file)} has no mod behaviour type; the running Core keeps running.");
                _busy = false;
                yield break;
            }

            // 2. Tear down the old Core: destroy its object, let OnDisable run at the end of the frame, wait two frames.
            if (_coreGo != null)
            {
                var old = _coreGo;
                _coreGo = null;
                try { old.GetComponent<Duckov.Modding.ModBehaviour>()?.NotifyBeforeDeactivate(); }
                catch (Exception e) { Debug.LogException(e); }
                Destroy(old);
                yield return null;
                yield return null;
            }

            Report(_loadCount == 0 ? "before-load" : "after-unload");

            // 3. Start the new Core: AddComponent runs its OnEnable; Setup hands over the game's manager and mod info.
            _loadedCores.Add(asm);
            _loadedEntries.Add(entry);
            _loadedNames.Add(asm.GetName().Name);
            try
            {
                var go = new GameObject(ModName + ".Core");
                go.transform.SetParent(transform, false);
                _coreGo = go;
                var core = (Duckov.Modding.ModBehaviour)go.AddComponent(entry);
                core.Setup(master, info);
            }
            catch (Exception e)
            {
                Debug.LogError($"[HotReload] {Path.GetFileName(file)} failed while starting; the shim keeps running for the next build.");
                Debug.LogException(e);
            }

            _loadedName = asm.GetName().Name;
            _loadedWrite = write;
            _loadCount++;
            yield return null;
            Report("after-load");
            _busy = false;
        }

        /// <summary>The Core file with the greatest stamp (the stamp is a fixed-width UTC timestamp).</summary>
        private string NewestCoreFile()
        {
            if (!Directory.Exists(_dir)) return null;
            return Directory.GetFiles(_dir, CorePrefix + "*.dll")
                .OrderByDescending(f => Path.GetFileName(f), StringComparer.Ordinal)
                .ThenByDescending(f => File.GetLastWriteTimeUtc(f))
                .FirstOrDefault();
        }

        /// <summary>The one non-abstract type of the Core that derives from the game's mod behaviour class.</summary>
        private static Type FindEntryType(Assembly asm)
        {
            Type[] types;
            try { types = asm.GetTypes(); }
            catch (ReflectionTypeLoadException e) { types = e.Types.Where(t => t != null).ToArray(); }

            var candidates = types
                .Where(t => t.IsClass && !t.IsAbstract && typeof(Duckov.Modding.ModBehaviour).IsAssignableFrom(t))
                .ToList();
            if (candidates.Count == 1) return candidates[0];

            var named = candidates.Where(t => t.Name == "ModBehaviour").ToList();
            if (named.Count == 1) return named[0];

            Debug.LogError($"[HotReload] expected one mod behaviour type in {asm.GetName().Name}, found {candidates.Count}.");
            return null;
        }

        /// <summary>
        /// One line the test run greps. Generic counts come from the game and from this shim's object; the Core may add
        /// its own counts through a public static method <c>HotReloadReport()</c> that returns a string (Ducky.Sdk
        /// mods keep their Harmony, subscription and localization counts there).
        /// </summary>
        private void Report(string stage)
        {
            var coreAssemblies = AppDomain.CurrentDomain.GetAssemblies()
                .Count(a => a.GetName().Name.StartsWith(CorePrefix, StringComparison.Ordinal));
            var hosts = FindObjectsOfType<MonoBehaviour>().Count(m => m != null && m.GetType().Name == "ModHttpV1");
            var detail = CoreDetail();
            Debug.Log($"[HotReload] REPORT load={_loadCount} stage={stage} core={_loadedName ?? "none"} " +
                      $"coreAssembliesInDomain={coreAssemblies} childObjects={transform.childCount} hostComponents={hosts} " +
                      $"buffs={CountCoreBuffs()}" + (string.IsNullOrEmpty(detail) ? "" : " " + detail));
        }

        private string CoreDetail()
        {
            if (_loadedEntries.Count == 0) return "";
            var method = _loadedEntries[_loadedEntries.Count - 1].GetMethod(ReportMethod, BindingFlags.Public | BindingFlags.Static);
            if (method == null) return "";
            try { return method.Invoke(null, null) as string ?? ""; }
            catch (Exception e) { return "coreReport=error:" + e.GetType().Name; }
        }

        /// <summary>Buffs in the game's list whose type comes from a Core of this mod (any load, old or new).</summary>
        private static int CountCoreBuffs()
        {
            try
            {
                var data = GameplayDataSettings.Buffs;
                var field = data.GetType().GetField("allBuffs", BindingFlags.Instance | BindingFlags.NonPublic | BindingFlags.Public);
                var list = (List<Duckov.Buffs.Buff>)field.GetValue(data);
                return list.Count(b => b != null && b.GetType().Assembly.GetName().Name.StartsWith(CorePrefix, StringComparison.Ordinal));
            }
            catch (Exception)
            {
                return -1;
            }
        }

        /// <summary>
        /// The Core is loaded from bytes, so there is no file location: its references are answered here. The shim
        /// itself is already loaded; 0Harmony and other dependencies sit beside the shim, or in its Dependency folder.
        /// </summary>
        private Assembly OnResolve(object sender, ResolveEventArgs args)
        {
            var name = new AssemblyName(args.Name).Name;
            if (name == ModName) return typeof(ModBehaviour).Assembly;
            if (name.StartsWith(CorePrefix, StringComparison.Ordinal)) return null;

            foreach (var folder in new[] { _dir, Path.Combine(_dir, "Dependency") })
            {
                var path = Path.Combine(folder, name + ".dll");
                if (File.Exists(path)) return Assembly.LoadFrom(path);
            }

            return null;
        }
    }
}
