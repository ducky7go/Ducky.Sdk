<Project>
  <PropertyGroup>
    <!-- 启用 Source Generator 生成文件到磁盘，以便 MSBuild targets 可以读取 -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <!-- 指定生成文件的输出目录（可选，默认是 obj/$(Configuration)/$(TargetFramework)/generated） -->
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)generated</CompilerGeneratedFilesOutputPath>

    <!-- 全局 using 配置，默认启用 -->
    <EnableGlobalUsing Condition="'$(EnableGlobalUsing)' == ''">true</EnableGlobalUsing>

    <!-- 确保 NuGet 依赖的 DLL 被复制到输出目录，以便 ILRepack 可以合并它们 -->
    <CopyLocalLockFileAssemblies Condition="'$(CopyLocalLockFileAssemblies)' == ''">true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- Initialize SDK properties before build -->
  <Target Name="InitializeDuckySdkProperties" BeforeTargets="BeforeBuild;BeforeResolveReferences">
    <PropertyGroup>
      <!-- DuckovFolder: if already specified externally, use it; otherwise require SteamFolder -->
      <DuckovFolder Condition=" '$(DuckovFolder)' == '' AND '$(SteamFolder)' != '' ">$(SteamFolder)steamapps/common/Escape from Duckov/</DuckovFolder>
      <!-- Allow explicit override of ManagedDirectory and ModsDirectory for CI environments -->
      <!-- Only set from DuckovFolder if not already explicitly set -->
      <ManagedDirectory Condition=" '$(ManagedDirectory)' == '' AND '$(DuckovFolder)' != '' ">$(DuckovFolder)Duckov_Data/Managed/</ManagedDirectory>
      <ModsDirectory Condition=" '$(ModsDirectory)' == '' AND '$(DuckovFolder)' != '' ">$(DuckovFolder)Duckov_Data/Mods/</ModsDirectory>

      <!-- 初始化本地化处理标志
           ExcludeSdkLib 只影响 SDK 代码和引用，不影响 mod 特定的本地化处理
           始终启用本地化处理，因为 mod 项目需要处理自己的本地化文件 -->
      <_ShouldProcessLocalization>true</_ShouldProcessLocalization>

      <!-- 启用 ILRepack 合并，默认开启 -->
      <EnableILRepack Condition="'$(EnableILRepack)' == ''">true</EnableILRepack>

      <!-- 是否包含 Harmony 支持，默认不包含 -->
      <IncludeHarmony Condition="'$(IncludeHarmony)' == ''">false</IncludeHarmony>

      <!-- 默认 AssetsDir：所有项目（包括 ModLib）都需要 assets 目录来处理本地化 -->
      <AssetsDir Condition="'$(AssetsDir)' == '' OR '$(AssetsDir)' == '$(MSBuildProjectDirectory)assets'">$([System.IO.Path]::Combine('$(MSBuildProjectDirectory)','assets'))</AssetsDir>

      <!-- 本地化资源目录，如果未指定则使用 AssetsDir -->
      <LocalizationAssetsDir Condition="'$(LocalizationAssetsDir)' == ''">$(AssetsDir)</LocalizationAssetsDir>

      <!-- Default values for deployment configuration -->
      <DeployMod Condition="'$(DeployMod)' == ''">true</DeployMod>
      <ExcludeSdkLib Condition="'$(ExcludeSdkLib)' == ''">false</ExcludeSdkLib>
      <IsModLib Condition="'$(IsModLib)' == ''">false</IsModLib>

      <!-- IsModLib specific configuration -->
      <!-- For library projects, disable mod deployment and packaging by default -->
      <DeployMod Condition="'$(IsModLib)' == 'true'">false</DeployMod>

      <!-- IsModLib projects still process localization but skip all other automation -->
      <_ShouldProcessLocalization Condition="'$(IsModLib)' == 'true'">true</_ShouldProcessLocalization>
    </PropertyGroup>

    <Message Text="[Ducky.Sdk] SteamFolder: $(SteamFolder)" Importance="high" />
    <Message Text="[Ducky.Sdk] DuckovFolder: $(DuckovFolder)" Importance="high" />
    <Message Text="[Ducky.Sdk] ManagedDirectory: $(ManagedDirectory)" Importance="high" />
    <Message Text="[Ducky.Sdk] EnableILRepack: $(EnableILRepack)" Importance="high" />
    <Message Text="[Ducky.Sdk] IncludeHarmony: $(IncludeHarmony)" Importance="high" />
    <Message Text="[Ducky.Sdk] LocalizationAssetsDir: $(LocalizationAssetsDir)" Importance="high" />
    <Message Text="[Ducky.Sdk] AssetsDir: $(AssetsDir)" Importance="high" />
    <Message Text="[Ducky.Sdk] IsModLib: $(IsModLib)" Importance="high" Condition="'$(IsModLib)' != ''" />
    <Message Text="[Ducky.Sdk] DeployMod: $(DeployMod)" Importance="high" />
    <Message Text="[Ducky.Sdk] Project mode: Library project (automation tasks will be skipped)" Importance="high"
             Condition="'$(IsModLib)' == 'true'" />
    <Message Text="[Ducky.Sdk] Project mode: Final release mod project (full automation enabled)" Importance="high"
             Condition="'$(IsModLib)' != 'true' AND '$(ModName)' != ''" />
    <Message Text="[Ducky.Sdk] Global using: $(EnableGlobalUsing)" Importance="high" />
    <Message
      Text="[Ducky.Sdk] Global using enabled - SDK, game engine, and common namespaces will be automatically imported"
      Importance="high"
      Condition="'$(EnableGlobalUsing)' == 'true'" />
    <Message Text="[Ducky.Sdk] Global using disabled - explicit using statements required" Importance="high"
             Condition="'$(EnableGlobalUsing)' == 'false'" />
  </Target>


  <Target Name="AddHarmonyReference" BeforeTargets="BeforeResolveReferences"
          Condition=" '$(IncludeHarmony)' == 'true' ">
    <PropertyGroup>
      <_HarmonyDllPath>$(MSBuildThisFileDirectory)../tools/0Harmony.dll</_HarmonyDllPath>
    </PropertyGroup>

    <ItemGroup>
      <Reference Include="0Harmony" Condition="Exists('$(_HarmonyDllPath)')">
        <HintPath>$(_HarmonyDllPath)</HintPath>
        <Private>true</Private>
      </Reference>
    </ItemGroup>

    <Message Text="[Ducky.Sdk] Adding Harmony reference from $(_HarmonyDllPath)" Importance="high"
             Condition="Exists('$(_HarmonyDllPath)')" />
    <Warning Text="[Ducky.Sdk] IncludeHarmony is true but 0Harmony.dll not found at $(_HarmonyDllPath)"
             Condition="!Exists('$(_HarmonyDllPath)')" />
  </Target>

  <!-- 全局 using 指令 -->
  <ItemGroup Condition=" '$(EnableGlobalUsing)' == 'true' ">
    <!-- 核心 SDK 命名空间 -->
    <Using Include="Ducky.Sdk.ModBehaviours" />
    <Using Include="Ducky.Sdk.Logging" />
    <Using Include="Ducky.Sdk.Attributes" />
    <Using Include="Ducky.Sdk.Options" />
    <Using Include="Ducky.Sdk.Contracts" />
    <Using Include="Ducky.Sdk.Contracts.CommandLine" />
    <Using Include="Ducky.Sdk.Localizations" />
    <Using Include="Ducky.Sdk.GameApis" />

    <!-- 游戏引擎命名空间 - 仅在游戏依赖可用时添加 -->
    <Using Include="Unity" />
    <Using Include="UnityEngine" />
    <Using Include="UnityEngine.UI" />
    <Using Include="UnityEngine.SceneManagement" />
    <Using Include="UnityEngine.EventSystems" />

    <!-- 第三方库命名空间 -->
    <Using Include="Newtonsoft.Json" />
    <Using Include="Cysharp.Threading.Tasks" />
    <Using Include="Cysharp.Threading.Tasks.Linq" />
    <Using Include="Cysharp.Threading.Tasks.Triggers" />

    <!-- 常用系统命名空间 -->
    <Using Include="System.Linq" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.Threading.Tasks" />
    <Using Include="System.IO" />
  </ItemGroup>

  <!-- Hide content files from Visual Studio solution explorer for this package -->
  <ItemGroup>
    <!-- Filter only Compile items coming from the Ducky.Sdk package -->
    <_DuckySdkCompileForVisibility
      Include="@(Compile->WithMetadataValue('NuGetPackageId','Ducky.Sdk')->WithMetadataValue('NuGetItemType','Compile'))" />
    <Compile Update="@(_DuckySdkCompileForVisibility)">
      <Visible>false</Visible>
    </Compile>
  </ItemGroup>

  <!-- Collect SDK library source files (works in repo dev; may not exist in consumer env) -->
  <ItemGroup Condition=" '$(ModName)' != '' ">
    <PngFiles Include="icons/**/*.png" />
    <AssetsFiles Include="assets/**/*.*" />
    <SDKlibFiles
      Include="@(Compile->WithMetadataValue('NuGetPackageId','Ducky.Sdk')->WithMetadataValue('NuGetItemType','Compile'))" />
  </ItemGroup>

  <ItemGroup Condition=" '$(ExcludeSdkLib)' != 'true' ">
    <!-- Remove them from Compile so they don't get compiled -->
    <Compile Update="@(SDKlibFiles)" Link="Shared\SDKlibs\%(RecursiveDir)%(Filename)%(Extension)">
      <Visible>false</Visible>
    </Compile>
  </ItemGroup>

  <ItemGroup Condition=" '$(ExcludeSdkLib)' == 'true' ">
    <Compile Remove="@(SDKlibFiles)" />
    <None Include="@(SDKlibFiles)" Link="Shared\SDKlibs\%(RecursiveDir)%(Filename)%(Extension)">
      <Visible>false</Visible>
    </None>
  </ItemGroup>

  <!-- Dynamically find and add assembly references from ManagedDirectory -->
  <Target Name="AddDuckyManagedReferences" BeforeTargets="ResolveAssemblyReferences;BeforeResolveReferences"
          DependsOnTargets="InitializeDuckySdkProperties"
          Condition=" '$(ManagedDirectory)' != '' AND Exists('$(ManagedDirectory)') ">

    <ItemGroup>
      <!-- Find all TeamSoda DLLs -->
      <_TeamSodaDlls Include="$(ManagedDirectory)TeamSoda*.dll" />
      <!-- Find all Unity DLLs -->
      <_UnityDlls Include="$(ManagedDirectory)Unity*.dll" />
      <!-- Find all FOW DLLs -->
      <_FOWDlls Include="$(ManagedDirectory)FOW*.dll" />
      <!-- Find all SodaLocalization DLLs -->
      <_SodaLocalizationDlls Include="$(ManagedDirectory)SodaLocalization*.dll" />

      <_SpecificDlls Include="$(ManagedDirectory)ItemStatsSystem.dll" />
      <_SpecificDlls Include="$(ManagedDirectory)Newtonsoft.Json.dll" />
      <_SpecificDlls Include="$(ManagedDirectory)EasySave3.dll" />
      <_SpecificDlls Include="$(ManagedDirectory)UniTask.dll" />
      <_SpecificDlls Include="$(ManagedDirectory)Eflatun.SceneReference.dll" />
      <_SpecificDlls Include="$(ManagedDirectory)com.rlabrecque.steamworks.net.dll" />
      <_SpecificDlls Include="$(ManagedDirectory)DOTween*.dll" />
      <_SpecificDlls Include="$(ManagedDirectory)UniTask*.dll" />
      <!-- Combine all found DLLs -->
      <_AllManagedDlls Include="@(_TeamSodaDlls);@(_UnityDlls);@(_FOWDlls);@(_SodaLocalizationDlls);@(_SpecificDlls);" />
    </ItemGroup>

    <Message Text="[Ducky.Sdk] Found @(_AllManagedDlls->Count()) managed assemblies to reference" Importance="high" />
    <Message Text="[Ducky.Sdk] References: @(_AllManagedDlls->'%(Filename)', ', ')" Importance="high"
             Condition="@(_AllManagedDlls->Count()) > 0" />

    <ItemGroup>
      <Reference Include="@(_AllManagedDlls)">
        <HintPath>%(Identity)</HintPath>
        <Private>false</Private>
      </Reference>
    </ItemGroup>

    <Warning
      Text="[Ducky.Sdk] ManagedDirectory is set but no managed assemblies were found. Please check if the game is installed or run fetch_build_dependency.sh"
      Condition="@(_AllManagedDlls->Count()) == 0" />
  </Target>

  <!-- Fallback warning if ManagedDirectory doesn't exist -->
  <Target Name="WarnMissingManagedDirectory" BeforeTargets="BeforeBuild"
          DependsOnTargets="InitializeDuckySdkProperties"
          Condition=" '$(ManagedDirectory)' == '' OR !Exists('$(ManagedDirectory)') ">
    <Warning
      Text="[Ducky.Sdk] ManagedDirectory '$(ManagedDirectory)' does not exist. Game references will not be available." />
  </Target>

</Project>
