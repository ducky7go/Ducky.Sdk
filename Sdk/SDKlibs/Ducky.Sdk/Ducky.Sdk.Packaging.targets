<Project>
    <!-- Main deployment orchestration target - runs after Build and manages all deployment operations -->
    <Target Name="DeployMod" AfterTargets="Build"
            DependsOnTargets="LogDeployModPrevention;CopyToDuckov;PackModWithILRepack;CopyMissingDependencies"
            Condition=" '$(ModName)' != '' AND '$(IsModLib)' != 'true' ">
    </Target>

    <!-- Log deployment prevention when DeployMod=false -->
    <Target Name="LogDeployModPrevention"
            Condition=" '$(ModName)' != '' AND '$(DeployMod)' == 'false' AND '$(IsModLib)' != 'true' ">
        <Message Text="[DeployMod] Deployment prevention - DeployMod=false, all deployment operations are skipped"
                 Importance="High" />
        <Message Text="[DeployMod] ILRepack operations are disabled due to DeployMod=false" Importance="High"
                 Condition=" '$(EnableILRepack)' == 'true' " />
        <Message Text="[DeployMod] Dependency copying is disabled due to DeployMod=false" Importance="High"
                 Condition=" '$(EnableILRepack)' != 'true' " />
    </Target>

    <!-- Main cleanup orchestration target - runs after all deployment operations -->
    <Target Name="CleanupAfterDeployMod" AfterTargets="Build"
            DependsOnTargets="RemoveIfDeployModFalse"
            Condition=" '$(ModName)' != '' AND '$(IsModLib)' != 'true' ">
    </Target>

    <Target Name="CopyToDuckov"
            Condition=" '$(DuckovFolder)' != '' AND '$(ModName)' != '' AND '$(DeployMod)' != 'false' AND '$(IsModLib)' != 'true' ">
        <!-- 先删除目标文件夹的所有内容，确保环境纯净 -->
        <RemoveDir Directories="$(ModsDirectory)$(ModName)" Condition="Exists('$(ModsDirectory)$(ModName)')" />

        <!-- Ensure destination folder exists -->
        <MakeDir Directories="$(ModsDirectory)$(ModName)" />

        <!-- copy preview.png and info.ini -->
        <Copy SourceFiles="@(AssetsFiles)"
              DestinationFiles="@(AssetsFiles->'$(ModsDirectory)$(ModName)/%(RecursiveDir)%(Filename)%(Extension)')"
              SkipUnchangedFiles="false" />

        <!-- Copy the project output DLL -->
        <Copy SourceFiles="$(TargetPath)"
              DestinationFolder="$(ModsDirectory)$(ModName)/"
              SkipUnchangedFiles="false" />

        <!-- Copy PDB file if exists (will be overwritten by PackModWithILRepack if enabled) -->
        <PropertyGroup>
            <_OriginalPdbPath>$(TargetDir)$(TargetName).pdb</_OriginalPdbPath>
        </PropertyGroup>
        <Copy SourceFiles="$(_OriginalPdbPath)"
              DestinationFolder="$(ModsDirectory)$(ModName)/"
              SkipUnchangedFiles="false"
              Condition="Exists('$(_OriginalPdbPath)')" />

        <!-- Copy deps.json to mod output folder if exists -->
        <ItemGroup>
            <_DepsJsonFile Include="$(TargetDir)$(TargetName).deps.json"
                           Condition="Exists('$(TargetDir)$(TargetName).deps.json')" />
        </ItemGroup>
        <Copy SourceFiles="@(_DepsJsonFile)"
              DestinationFolder="$(ModsDirectory)$(ModName)/"
              SkipUnchangedFiles="false"
              Condition="@(_DepsJsonFile) != ''" />

    </Target>

    <!-- Log when CopyToDuckov is skipped due to IsModLib -->
    <Target Name="LogCopyToDuckovSkipped" BeforeTargets="BeforeBuild"
            Condition=" '$(IsModLib)' == 'true' AND '$(ModName)' != '' AND '$(DeployMod)' != 'false' ">
        <Message Text="[CopyToDuckov] Skipped - IsModLib=true, library projects are not deployed to game directory"
                 Importance="high" />
    </Target>

    <Target Name="RemoveIfDeployModFalse"
            Condition=" '$(ModName)' != '' AND '$(DeployMod)' == 'false' AND '$(IsModLib)' != 'true' ">
        <PropertyGroup>
            <_TargetModDir>$(ModsDirectory)$(ModName)</_TargetModDir>
        </PropertyGroup>

        <!-- Validate configuration before proceeding -->
        <Message Text="[RemoveIfDeployModFalse] DeployMod is set to false, checking if mod directory cleanup is needed"
                 Importance="High" />
        <Message Text="[RemoveIfDeployModFalse] Target mod directory: $(_TargetModDir)" Importance="High" />

        <!-- Check if required configuration is missing -->
        <Message
            Text="[RemoveIfDeployModFalse] Warning: DuckovFolder is not configured, cannot determine mod directory"
            Importance="High"
            Condition=" '$(DuckovFolder)' == '' " />
        <Message Text="[RemoveIfDeployModFalse] Warning: ModName is not specified, cannot determine mod directory"
                 Importance="High"
                 Condition=" '$(ModName)' == '' " />

        <!-- Skip if library project -->
        <Message
            Text="[RemoveIfDeployModFalse] Skipped - IsModLib=true, library projects are not deployed, no cleanup needed"
            Importance="High"
            Condition=" '$(IsModLib)' == 'true' " />

        <!-- Check if directory exists -->
        <Message Text="[RemoveIfDeployModFalse] Mod directory does not exist, no cleanup needed" Importance="High"
                 Condition="!Exists('$(_TargetModDir)')" />

        <!-- Attempt to remove directory with error handling -->
        <Message Text="[RemoveIfDeployModFalse] Removing mod directory: $(_TargetModDir)" Importance="High"
                 Condition="Exists('$(_TargetModDir)')" />

        <RemoveDir Directories="$(_TargetModDir)"
                   ContinueOnError="true"
                   Condition="Exists('$(_TargetModDir)')" />

        <!-- Verify deletion was successful -->
        <Message Text="[RemoveIfDeployModFalse] Successfully removed mod directory: $(_TargetModDir)" Importance="High"
                 Condition="Exists('$(_TargetModDir)') == false" />

        <Message Text="[RemoveIfDeployModFalse] Error: Failed to remove mod directory: $(_TargetModDir)"
                 Importance="High"
                 Condition="Exists('$(_TargetModDir)')" />
    </Target>

    <!-- 依赖收集逻辑独立为 CollectModDependencies Target -->
    <Target Name="CollectModDependencies">
        <!-- 收集项目输出目录中的所有 DLL 文件（排除项目自身的输出 DLL） -->
        <ItemGroup>
            <_AllOutputDlls Include="$(TargetDir)*.dll" Exclude="$(TargetPath)" />
        </ItemGroup>
        <!-- 收集 ManagedDirectory 中的所有 DLL 文件名（仅文件名，不含路径） -->
        <ItemGroup>
            <_ManagedDlls Include="$(ManagedDirectory)*.dll" />
            <_ManagedDllNames Include="@(_ManagedDlls->'%(Filename)%(Extension)')" />
        </ItemGroup>
        <!-- 分离需要复制和可合并的 DLL -->
        <ItemGroup>
            <_DllsToCopy Include="@(_AllOutputDlls)"
                         Condition=" !@(_ManagedDllNames->AnyHaveMetadataValue('Identity', '%(Filename)%(Extension)')) " />
            <_DllsToPack Include="@(_AllOutputDlls)"
                         Condition=" !@(_ManagedDllNames->AnyHaveMetadataValue('Identity', '%(Filename)%(Extension)')) " />
        </ItemGroup>
    </Target>

    <!-- 复制项目输出目录中不在 ManagedDirectory 的所有 DLL 到 Mod 的 Dependency 文件夹 -->
    <Target Name="CopyMissingDependencies"
            DependsOnTargets="CollectModDependencies"
            Condition=" '$(DuckovFolder)' != '' AND '$(ModName)' != '' AND '$(DeployMod)' != 'false' AND '$(EnableILRepack)' != 'true' AND '$(IsModLib)' != 'true' ">
        <PropertyGroup>
            <_DestDir>$(ModsDirectory)$(ModName)/Dependency/</_DestDir>
        </PropertyGroup>
        <Message Text="[CopyMissingDependencies] Found @(_DllsToCopy->Count()) DLL(s) to copy" Importance="High" />
        <MakeDir Directories="$(_DestDir)" Condition=" '@(_DllsToCopy)' != '' " />
        <Copy SourceFiles="@(_DllsToCopy)"
              DestinationFolder="$(_DestDir)"
              SkipUnchangedFiles="false"
              OverwriteReadOnlyFiles="true"
              Condition=" '@(_DllsToCopy)' != '' ">
            <Output TaskParameter="CopiedFiles" ItemName="_CopiedDependencies" />
        </Copy>
        <Message
            Text="[CopyMissingDependencies] Copied @(_CopiedDependencies->Count()) DLL(s) to Dependency folder: @(_CopiedDependencies->'%(Filename)%(Extension)', ', ')"
            Importance="High"
            Condition="@(_CopiedDependencies) != ''" />
        <Message Text="[CopyMissingDependencies] No dependencies to copy"
                 Importance="High"
                 Condition="@(_CopiedDependencies) == '' AND @(_DllsToCopy) == ''" />
    </Target>

    <!-- Log when CopyMissingDependencies is skipped due to IsModLib -->
    <Target Name="LogCopyMissingDependenciesSkipped" BeforeTargets="BeforeBuild"
            Condition=" '$(IsModLib)' == 'true' AND '$(ModName)' != '' AND '$(DeployMod)' != 'false' AND '$(EnableILRepack)' != 'true' ">
        <Message Text="[CopyMissingDependencies] Skipped - IsModLib=true, library projects do not copy dependencies"
                 Importance="high" />
    </Target>

    <!-- 新增 PackModWithILRepack Target，合并主 DLL 和依赖项 -->
    <Target Name="PackModWithILRepack"
            DependsOnTargets="CollectModDependencies"
            Condition=" '$(EnableILRepack)' == 'true' AND '$(DuckovFolder)' != '' AND '$(ModName)' != '' AND '$(DeployMod)' != 'false' AND '$(IsModLib)' != 'true' ">
        <PropertyGroup>
            <_FinalModDll>$(ModsDirectory)$(ModName)/$(ModName).dll</_FinalModDll>
            <!-- 创建临时文件夹用于 ILRepack 输出，避免程序集名称包含 .packed.tmp 后缀 -->
            <_ILRepackTempDir>$(ModsDirectory)$(ModName)/.ilrepack_temp/</_ILRepackTempDir>
            <_TempPackedDll>$(_ILRepackTempDir)$(ModName).dll</_TempPackedDll>
            <!-- 构建带引号的依赖 DLL 列表 -->
            <_DllsToPackList>@(_DllsToPack->'&quot;%(FullPath)&quot;', ' ')</_DllsToPackList>
        </PropertyGroup>

        <!-- Check if there are any dependencies to merge -->
        <Message Text="[PackModWithILRepack] No dependencies found, skipping ILRepack" Importance="High"
                 Condition=" '@(_DllsToPack)' == '' " />

        <!-- Skip ILRepack if no dependencies, just copy the original DLL and PDB -->
        <MakeDir Directories="$(ModsDirectory)$(ModName)" Condition=" '@(_DllsToPack)' == '' " />
        <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(_FinalModDll)" OverwriteReadOnlyFiles="true"
              Condition=" '@(_DllsToPack)' == '' " />
        <PropertyGroup Condition=" '@(_DllsToPack)' == '' ">
            <_OriginalPdbPath>$([System.IO.Path]::ChangeExtension('$(TargetPath)', '.pdb'))</_OriginalPdbPath>
            <_FinalPdbPath>$([System.IO.Path]::ChangeExtension('$(_FinalModDll)', '.pdb'))</_FinalPdbPath>
        </PropertyGroup>
        <Copy SourceFiles="$(_OriginalPdbPath)" DestinationFiles="$(_FinalPdbPath)" OverwriteReadOnlyFiles="true"
              Condition=" '@(_DllsToPack)' == '' AND Exists('$(_OriginalPdbPath)') " />
        <Message Text="[PackModWithILRepack] Copied original DLL and PDB (no merging needed)" Importance="High"
                 Condition=" '@(_DllsToPack)' == '' " />

        <!-- Only run ILRepack if there are dependencies -->
        <MakeDir Directories="$(ModsDirectory)$(ModName)" Condition=" '@(_DllsToPack)' != '' " />
        <MakeDir Directories="$(_ILRepackTempDir)" Condition=" '@(_DllsToPack)' != '' " />

        <!-- 收集所有可能包含依赖项的目录 -->
        <ItemGroup Condition=" '@(_DllsToPack)' != '' ">
            <!-- 1. 项目输出目录（包含所有复制的依赖项） -->
            <_ILRepackLibDirs Include="$(TargetDir)" />
            <!-- 2. ManagedDirectory（游戏的托管程序集） -->
            <_ILRepackLibDirs Include="$(ManagedDirectory)"
                              Condition=" '$(ManagedDirectory)' != '' AND Exists('$(ManagedDirectory)') " />
            <!-- 3. 收集所有引用程序集的目录（去重） -->
            <_ILRepackLibDirs Include="@(ReferencePath->'%(RootDir)%(Directory)')" />
            <!-- 4. NuGet 包的运行时程序集目录 -->
            <_ILRepackLibDirs Include="@(RuntimeCopyLocalItems->'%(RootDir)%(Directory)')" />
        </ItemGroup>

        <!-- 去重并构建 /lib 参数列表 -->
        <RemoveDuplicates Inputs="@(_ILRepackLibDirs)" Condition=" '@(_DllsToPack)' != '' ">
            <Output TaskParameter="Filtered" ItemName="_UniqueLibDirs" />
        </RemoveDuplicates>

        <PropertyGroup Condition=" '@(_DllsToPack)' != '' ">
            <!-- 构建 /lib 参数：每个目录添加 /lib:"path" -->
            <_LibPathArgs>@(_UniqueLibDirs->'/lib:&quot;%(Identity).&quot;', ' ')</_LibPathArgs>
        </PropertyGroup>

        <Message Text="[PackModWithILRepack] Merging mod DLL and dependencies into $(_FinalModDll)" Importance="High"
                 Condition=" '@(_DllsToPack)' != '' " />
        <Message Text="[PackModWithILRepack] Primary DLL: $(TargetPath)" Importance="High"
                 Condition=" '@(_DllsToPack)' != '' " />
        <Message Text="[PackModWithILRepack] Dependencies to merge: @(_DllsToPack->'%(Filename)%(Extension)', ', ')"
                 Importance="High"
                 Condition=" '@(_DllsToPack)' != '' " />
        <Message Text="[PackModWithILRepack] Library search paths (@(_UniqueLibDirs->Count()) directories):"
                 Importance="High"
                 Condition=" '@(_DllsToPack)' != '' " />
        <Message Text="  - %(_UniqueLibDirs.Identity)" Importance="High"
                 Condition=" '@(_DllsToPack)' != '' " />
        <Message Text="[PackModWithILRepack] Generated lib args: $(_LibPathArgs)" Importance="High"
                 Condition=" '@(_DllsToPack)' != '' " />

        <Message
            Text="[PackModWithILRepack] Running ILRepack with minimal output (EnableILRepackVerbose=false). Set EnableILRepackVerbose=true for detailed logging."
            Importance="High"
            Condition=" '@(_DllsToPack)' != '' AND '$(EnableILRepackVerbose)' != 'true' " />

        <Message Text="[PackModWithILRepack] Running ILRepack with verbose output (EnableILRepackVerbose=true)"
                 Importance="High"
                 Condition=" '@(_DllsToPack)' != '' AND '$(EnableILRepackVerbose)' == 'true' " />

        <!-- 先输出到临时文件夹，使用收集的所有 lib 路径 -->
        <Exec
            Command="ilrepack /out:&quot;$(_TempPackedDll)&quot; &quot;$(TargetPath)&quot; $(_DllsToPackList) /internalize /wildcards /log $(_LibPathArgs)"
            Condition=" '@(_DllsToPack)' != '' AND '$(EnableILRepackVerbose)' != 'true' " />

        <Exec
            Command="ilrepack /out:&quot;$(_TempPackedDll)&quot; &quot;$(TargetPath)&quot; $(_DllsToPackList) /internalize /wildcards /log /verbose $(_LibPathArgs)"
            Condition=" '@(_DllsToPack)' != '' AND '$(EnableILRepackVerbose)' == 'true' " />

        <!-- 从临时文件夹复制到最终位置（包括 DLL 和 PDB） -->
        <Copy SourceFiles="$(_TempPackedDll)" DestinationFiles="$(_FinalModDll)" OverwriteReadOnlyFiles="true"
              Condition=" '@(_DllsToPack)' != '' " />

        <!-- Copy the generated PDB file from ILRepack -->
        <PropertyGroup Condition=" '@(_DllsToPack)' != '' ">
            <_TempPackedPdb>$([System.IO.Path]::ChangeExtension('$(_TempPackedDll)', '.pdb'))</_TempPackedPdb>
            <_FinalModPdb>$([System.IO.Path]::ChangeExtension('$(_FinalModDll)', '.pdb'))</_FinalModPdb>
        </PropertyGroup>
        <Copy SourceFiles="$(_TempPackedPdb)" DestinationFiles="$(_FinalModPdb)" OverwriteReadOnlyFiles="true"
              Condition=" '@(_DllsToPack)' != '' AND Exists('$(_TempPackedPdb)') " />

        <Message Text="[PackModWithILRepack] Successfully merged all assemblies into $(_FinalModDll)" Importance="High"
                 Condition=" '@(_DllsToPack)' != '' " />
        <Message Text="[PackModWithILRepack] PDB file copied: $(_FinalModPdb)" Importance="High"
                 Condition=" '@(_DllsToPack)' != '' AND Exists('$(_TempPackedPdb)') " />
        <Message
            Text="[PackModWithILRepack] ILRepack operation completed. @(DllsToPack->Count()) assemblies merged successfully."
            Importance="High"
            Condition=" '@(_DllsToPack)' != '' " />
        <Message
            Text="[PackModWithILRepack] Verbose mode was $(EnableILRepackVerbose). Set EnableILRepackVerbose=true for detailed ILRepack output."
            Importance="High"
            Condition=" '@(_DllsToPack)' != '' " />

        <!-- 删除临时文件夹 -->
        <RemoveDir Directories="$(_ILRepackTempDir)" Condition=" '@(_DllsToPack)' != '' " />
    </Target>

    <!-- Log when PackModWithILRepack is skipped due to IsModLib -->
    <Target Name="LogPackModWithILRepackSkipped" BeforeTargets="BeforeBuild"
            Condition=" '$(IsModLib)' == 'true' AND '$(ModName)' != '' AND '$(EnableILRepack)' == 'true' ">
        <Message
            Text="[PackModWithILRepack] Skipped - IsModLib=true, library projects do not perform ILRepack assembly merging"
            Importance="high" />
    </Target>
</Project>
