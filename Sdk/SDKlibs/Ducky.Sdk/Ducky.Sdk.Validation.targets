<Project>
    <!-- Validation: Check for special characters in project path -->
    <Target Name="ValidateProjectPath" BeforeTargets="BeforeBuild">
        <PropertyGroup>
            <_ProjectPath>$(MSBuildProjectDirectory)</_ProjectPath>
            <_HasSpecialChars>false</_HasSpecialChars>
            <_HasSpecialChars Condition="$(_ProjectPath.Contains('#'))">true</_HasSpecialChars>
            <_HasSpecialChars Condition="$(_ProjectPath.Contains('&amp;'))">true</_HasSpecialChars>
            <_HasSpecialChars Condition="$(_ProjectPath.Contains(';'))">true</_HasSpecialChars>
            <_HasSpecialChars Condition="$(_ProjectPath.Contains('|'))">true</_HasSpecialChars>
            <_HasSpecialChars Condition="$(_ProjectPath.Contains('&lt;'))">true</_HasSpecialChars>
            <_HasSpecialChars Condition="$(_ProjectPath.Contains('&gt;'))">true</_HasSpecialChars>
            <_HasSpecialChars Condition="$(_ProjectPath.Contains('`'))">true</_HasSpecialChars>
        </PropertyGroup>
        <Error Condition=" '$(_HasSpecialChars)' == 'true' "
               Text="Project path contains command-line special characters (such as #, &amp;, ;, |, &lt;, &gt;, `): '$(_ProjectPath)'. These characters may cause build failures. Please move the project to a path without special characters." />
    </Target>

    <!-- Validation: the game folder or its Managed/Mods directories must be resolvable.
         DependsOnTargets makes the SDK derive ManagedDirectory/ModsDirectory first (including CI defaults),
         so only a truly unconfigured project fails here. -->
    <Target Name="ValidateDuckovFolder" BeforeTargets="BeforeBuild" DependsOnTargets="InitializeDuckySdkProperties">
        <Error Condition=" '$(DuckovFolder)' == '' AND '$(SteamFolder)' == '' AND '$(ManagedDirectory)' == '' AND '$(ModsDirectory)' == '' "
               Text="Either DuckovFolder or SteamFolder must be specified (or ManagedDirectory/ModsDirectory, or CI=true). Please set one of them in your project or Local.props file." />
    </Target>
</Project>
