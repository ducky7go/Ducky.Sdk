<Project>
    <!--
    Ducky.Sdk build orchestration.

    All build steps run in the Ducky.Sdk build runner, Ducky.Sdk.Build.dll, which is packed under tools/net10.0/.
    A build starts at most two runner processes, one per phase, and no external tool is needed:
    - GenerateBuildContext (BeforeBuild): writes the MSBuild property values to obj/ducky-build-properties.txt
    - ExecutePreBuildScripts (after CoreCompile): runner phase pre. It writes obj/ducky-build-context.json from
      the property file, then runs the pre steps (logging, validation, localization, info.ini, preview, collect).
    - ExecutePostBuildScripts (after Build): runner phase post. It updates the BuildContext with the compiled
      dependencies, then resets, merges (ILRepack), copies dependencies, deploys the mod and prints the result.

    The runner runs on the .NET host that runs this build ($(DOTNET_HOST_PATH)) and falls back to "dotnet".
    Paths are normalized with GetFullPath and quoted, so project folders and game folders may contain spaces.
    -->

    <PropertyGroup>
        <_DuckyBuildContextJsonFile>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/$(BaseIntermediateOutputPath)ducky-build-context.json'))</_DuckyBuildContextJsonFile>
        <_DuckyBuildPropertiesFile>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/$(BaseIntermediateOutputPath)ducky-build-properties.txt'))</_DuckyBuildPropertiesFile>
        <_DuckyBuildRunnerDll>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../tools/net10.0/Ducky.Sdk.Build.dll'))</_DuckyBuildRunnerDll>
        <_DuckyDotnetHost Condition="'$(DOTNET_HOST_PATH)' != ''">$(DOTNET_HOST_PATH)</_DuckyDotnetHost>
        <_DuckyDotnetHost Condition="'$(_DuckyDotnetHost)' == ''">dotnet</_DuckyDotnetHost>
        <_DuckyRunnerCommand>&quot;$(_DuckyDotnetHost)&quot; &quot;$(_DuckyBuildRunnerDll)&quot; &quot;$(_DuckyBuildContextJsonFile)&quot;</_DuckyRunnerCommand>
    </PropertyGroup>

    <!-- Fail with a restore hint when the runner is not in the package -->
    <Target Name="_DuckyCheckBuildRunner">
        <Error Condition="!Exists('$(_DuckyBuildRunnerDll)')"
               Text="Ducky.Sdk build runner not found: '$(_DuckyBuildRunnerDll)'. Restore the Ducky.Sdk package (dotnet restore), then rebuild. If the file is still missing, delete the Ducky.Sdk folder under the NuGet packages directory and restore again." />
    </Target>

    <!-- Generate the BuildContext: MakeDir, absolute paths, and the property file read by the runner's pre phase -->
    <Target Name="GenerateBuildContext" BeforeTargets="BeforeBuild" DependsOnTargets="_DuckyCheckBuildRunner">
        <Message Text="=== Generate BuildContext ===" Importance="normal" />
        <Message Text="Generating BuildContext JSON for: $(MSBuildProjectDirectory)" Importance="normal" />

        <!-- Convert paths to absolute paths -->
        <PropertyGroup>
            <_AbsoluteIntermediateOutputPath Condition="!$([System.IO.Path]::IsPathRooted($(IntermediateOutputPath)))">$([System.IO.Path]::GetFullPath($(MSBuildProjectDirectory)\$(IntermediateOutputPath)))</_AbsoluteIntermediateOutputPath>
            <_AbsoluteIntermediateOutputPath Condition="$([System.IO.Path]::IsPathRooted($(IntermediateOutputPath)))">$(IntermediateOutputPath)</_AbsoluteIntermediateOutputPath>
            <_AbsoluteBaseIntermediateOutputPath Condition="!$([System.IO.Path]::IsPathRooted($(BaseIntermediateOutputPath)))">$([System.IO.Path]::GetFullPath($(MSBuildProjectDirectory)\$(BaseIntermediateOutputPath)))</_AbsoluteBaseIntermediateOutputPath>
            <_AbsoluteBaseIntermediateOutputPath Condition="$([System.IO.Path]::IsPathRooted($(BaseIntermediateOutputPath)))">$(BaseIntermediateOutputPath)</_AbsoluteBaseIntermediateOutputPath>
            <_AbsoluteOutputPath Condition="!$([System.IO.Path]::IsPathRooted($(OutputPath)))">$([System.IO.Path]::GetFullPath($(MSBuildProjectDirectory)\$(OutputPath)))</_AbsoluteOutputPath>
            <_AbsoluteOutputPath Condition="$([System.IO.Path]::IsPathRooted($(OutputPath)))">$(OutputPath)</_AbsoluteOutputPath>
        </PropertyGroup>

        <!-- Ensure obj directory exists before the runner starts -->
        <MakeDir Directories="$(MSBuildProjectDirectory)\$(BaseIntermediateOutputPath)"
                 Condition="!Exists('$(MSBuildProjectDirectory)\$(BaseIntermediateOutputPath)')" />

        <!-- One line per property, "n=value". Escape ';' so a value such as LocalizationAssetsDir stays one value. -->
        <ItemGroup>
            <_DuckyBuildProperty Include="1=$([MSBuild]::Escape($(MSBuildProjectDirectory)))" />
            <_DuckyBuildProperty Include="2=$([MSBuild]::Escape($(ModName)))" />
            <_DuckyBuildProperty Include="3=$([MSBuild]::Escape($(Configuration)))" />
            <_DuckyBuildProperty Include="4=$([MSBuild]::Escape($(TargetFramework)))" />
            <_DuckyBuildProperty Include="5=$([MSBuild]::Escape($(DuckovFolder)))" />
            <_DuckyBuildProperty Include="6=$([MSBuild]::Escape($(SteamFolder)))" />
            <_DuckyBuildProperty Include="7=$([MSBuild]::Escape($(AssetsDir)))" />
            <_DuckyBuildProperty Include="8=$([MSBuild]::Escape($(LocalizationAssetsDir)))" />
            <_DuckyBuildProperty Include="9=$([MSBuild]::Escape($(EnableILRepack)))" />
            <_DuckyBuildProperty Include="10=$([MSBuild]::Escape($(EnableGlobalUsing)))" />
            <_DuckyBuildProperty Include="11=$([MSBuild]::Escape($(IncludeHarmony)))" />
            <_DuckyBuildProperty Include="12=$([MSBuild]::Escape($(DeployMod)))" />
            <_DuckyBuildProperty Include="13=$([MSBuild]::Escape($(ExcludeSdkLib)))" />
            <_DuckyBuildProperty Include="14=$([MSBuild]::Escape($(IsModLib)))" />
            <_DuckyBuildProperty Include="15=$([MSBuild]::Escape($(_AbsoluteIntermediateOutputPath)))" />
            <_DuckyBuildProperty Include="16=$([MSBuild]::Escape($(_AbsoluteBaseIntermediateOutputPath)))" />
            <_DuckyBuildProperty Include="17=$([MSBuild]::Escape($(_AbsoluteOutputPath)))" />
            <_DuckyBuildProperty Include="18=$([MSBuild]::Escape($(ManagedDirectory)))" />
            <_DuckyBuildProperty Include="19=$([MSBuild]::Escape($(ModsDirectory)))" />
        </ItemGroup>
        <WriteLinesToFile File="$(_DuckyBuildPropertiesFile)" Lines="@(_DuckyBuildProperty)" Overwrite="true" />

        <Message Text="✅ BuildContext properties written: $(_DuckyBuildPropertiesFile)" Importance="normal" />
    </Target>

    <!-- Execute the pre phase after CoreCompile: writes the BuildContext JSON, then runs the pre steps -->
    <Target Name="ExecutePreBuildScripts" AfterTargets="CoreCompile"
            DependsOnTargets="_DuckyCheckBuildRunner;GenerateBuildContext">
        <Message Text="=== Execute Pre-Build Build Steps (Ducky.Sdk.Build --phase pre) ===" Importance="normal" />

        <Exec Command="$(_DuckyRunnerCommand) --phase pre"
              ContinueOnError="false"
              IgnoreExitCode="true"
              WorkingDirectory="$(MSBuildProjectDirectory)">
            <Output TaskParameter="ExitCode" PropertyName="_DuckyPreExitCode" />
        </Exec>

        <Error Condition="'$(_DuckyPreExitCode)' != '0'"
               Text="Ducky.Sdk build runner failed in the pre phase (exit code $(_DuckyPreExitCode)). See the messages above. If the runner did not start, install the .NET 10 runtime (https://dotnet.microsoft.com/download/dotnet/10.0); newer .NET runtimes are also accepted." />

        <Message Text="✅ Pre-build build steps executed successfully" Importance="normal" />
    </Target>

    <!-- Execute the post phase after Build: updates the BuildContext, then deploys and prints the result -->
    <Target Name="ExecutePostBuildScripts" AfterTargets="Build"
            DependsOnTargets="ExecutePreBuildScripts">
        <Message Text="=== Execute Post-Build Build Steps (Ducky.Sdk.Build --phase post) ===" Importance="normal" />

        <Error Condition="!Exists('$(_DuckyBuildContextJsonFile)')"
               Text="BuildContext JSON file not found: $(_DuckyBuildContextJsonFile). Rebuild the project so the pre phase writes it." />

        <Exec Command="$(_DuckyRunnerCommand) --phase post"
              ContinueOnError="false"
              IgnoreExitCode="true"
              WorkingDirectory="$(MSBuildProjectDirectory)">
            <Output TaskParameter="ExitCode" PropertyName="_DuckyPostExitCode" />
        </Exec>

        <Error Condition="'$(_DuckyPostExitCode)' != '0'"
               Text="Ducky.Sdk build runner failed in the post phase (exit code $(_DuckyPostExitCode)). See the messages above. If the runner did not start, install the .NET 10 runtime (https://dotnet.microsoft.com/download/dotnet/10.0); newer .NET runtimes are also accepted." />

        <Message Text="✅ Post-build build steps executed successfully" Importance="normal" />
    </Target>

</Project>
